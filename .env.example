# Copy this file to .env and fill in the values for your environment.
# .env is never committed — see .gitignore.

# ── Django core ───────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-50-chars-minimum-random-string-here
# Comma-separated hostnames the app is allowed to serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 'none' | 'optional' | 'mandatory'
ACCOUNT_EMAIL_VERIFICATION=optional

# ── Database ──────────────────────────────────────────────────────────────────
# Leave DATABASE_URL unset (or commented out) to use SQLite (db.sqlite3).
# Uncomment and fill in the lines below for a PostgreSQL deployment.
# DATABASE_URL=postgres://scd:change-me@localhost:5432/scd
# POSTGRES_DB=scd
# POSTGRES_USER=scd
# POSTGRES_PASSWORD=change-me

# ── Docker / production only ──────────────────────────────────────────────────
# DJANGO_SETTINGS_MODULE=scd_reporting.settings.prod
# GUNICORN_WORKERS=3
# SCD_HOSTNAME=scd-reporting.fnal.gov

# ── First-run admin account ───────────────────────────────────────────────────
SCD_INITIAL_ADMIN_PASSWORD=change-me

# ── AI report summaries ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Default model: claude-sonnet-5
# ANTHROPIC_SUMMARY_MODEL=claude-sonnet-5
# Output ceiling for a summary. The default prompt asks for a table row per
# entry, so a report over a few dozen entries needs well over 2000 tokens.
# ANTHROPIC_MAX_TOKENS=16000
# Largest prompt the summariser will send; 0 disables the check.
# ANTHROPIC_MAX_INPUT_TOKENS=150000
# Leave unset to call the public Anthropic API directly. Set to route through
# a proxy such as litellm (e.g. https://litellm.fnal.gov).
# ANTHROPIC_BASE_URL=

# ── OIDC / Keycloak SSO ───────────────────────────────────────────────────────
# Set all three to enable the "Log in with SSO" button.
# OIDC_PROVIDER_URL=https://kc.apps.okddev.fnal.gov/realms/myrealm/.well-known/openid-configuration
# OIDC_CLIENT_ID=scd-report-summarizer
# OIDC_CLIENT_SECRET_FILE=/etc/scd/oidc_secret
# OIDC_CLIENT_SECRET=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Set both to enable the "Log in with Google" button.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── SMTP / email ──────────────────────────────────────────────────────────────
# Set EMAIL_HOST to enable real SMTP. Without it, Django's console backend is
# used and mail is printed instead of delivered. The development settings
# (scd_reporting.settings.dev) always use the console backend regardless.
# The lab gateway accepts on-site and OKD-cluster senders on port 25 without
# AUTH, and offers STARTTLS. Leave EMAIL_HOST_USER empty for it — Django only
# attempts a login when both the username and the password are set.
# EMAIL_HOST=smtp.fnal.gov
# EMAIL_PORT=25
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=scd-reporting@fnal.gov
# Force STARTTLS on ("1") or off ("0"); unset derives it from the port.
# EMAIL_USE_TLS=
# Set to 1 for full SMTP protocol tracing in the logs. Diagnostics only — it
# logs AUTH exchanges and message bodies. Never in production.
# SMTP_DEBUG=0

# ── Activity-report reminders ─────────────────────────────────────────────────
# Defaults come from config/reminders.yaml (copy config/reminders.yaml.example);
# anything set here overrides that file, and the send_reminders command's flags
# override both. See README "Email Reminders".
#
# Absolute site root for the links inside a reminder email. Required for
# scheduled sends, which have no HTTP request to derive it from. Falls back to
# https://$SCD_HOSTNAME when that is set.
# REMINDER_BASE_URL=https://scd-reporting.fnal.gov
# Skip a recipient reminded within this many hours (0 disables the guard).
# REMINDER_MIN_INTERVAL_HOURS=20
# Days without an entry before somebody counts as overdue.
# REMINDER_STALE_DAYS=14
# Upper bound on recipients per send.
# REMINDER_BATCH_SIZE=200
# Run the scheduler in-process as a daemon thread instead of from cron. Prefer
# the OKD CronJob (helm/simple: reminders.cronjob.enabled) in production.
# REMINDER_SCHEDULER_ENABLED=0
# REMINDER_SCHEDULER_INTERVAL=60

# ── Access control ────────────────────────────────────────────────────────────
# Set to 1 to block new local account sign-ups once SSO is working.
SCD_DISABLE_LOCAL_SIGNUP=0

# ── HashiCorp Vault (optional) ────────────────────────────────────────────────
# Set VAULT_ADDR *and* VAULT_SECRET_PATH to load secrets from Vault at startup
# instead of from this file. Leave both unset for local development — the loader
# is a no-op unless they are both present.
#
# Secrets are read from one KV v2 secret per service beneath the prefix:
#   <prefix>/anthropic  api_key                 -> ANTHROPIC_API_KEY
#   <prefix>/django     secret_key              -> DJANGO_SECRET_KEY
#                       initial_admin_password  -> SCD_INITIAL_ADMIN_PASSWORD
#   <prefix>/email      password                -> EMAIL_HOST_PASSWORD
#   <prefix>/google     client_secret           -> GOOGLE_CLIENT_SECRET
#   <prefix>/oidc       client_secret           -> OIDC_CLIENT_SECRET
#   <prefix>/postgres   password                -> POSTGRES_PASSWORD
#
# Anything already set to a non-empty value in this file wins over Vault.
# VAULT_ADDR=https://ssivault.fnal.gov:8200
# VAULT_SECRET_PATH=okd/shared/test/scd-reporting
# VAULT_TOKEN=
# AppRole login, used only when VAULT_TOKEN is not set:
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
# VAULT_APPROLE_MOUNT=auth/td-approles
# Set to 1 to start anyway if Vault is unreachable (default: fail fast).
# VAULT_OPTIONAL=0
